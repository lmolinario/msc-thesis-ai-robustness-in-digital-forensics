# =============================================================================
# Environment variable template
# =============================================================================
# Copy this file to .env only for local use if needed.
# Never commit .env or any file containing credentials, private links, or
# authentication tokens.

# Controlled-access raw dataset bundle URL.
# Populate only after explicit authorization by the thesis author or repository
# maintainer. Never commit or redistribute the received URL.
FAIRLAB_RAW_DATASET_BUNDLE_URL=

# Telegram acquisition credentials.
# Required only for datasets/scripts/acquisition/05_scrape_telegram.py.
TELEGRAM_API_ID=YOUR_API_ID
TELEGRAM_API_HASH=YOUR_API_HASH
TELEGRAM_SESSION_NAME=telegram_osint_session
