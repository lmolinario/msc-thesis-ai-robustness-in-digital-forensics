# =============================================================================
# Environment variable template
# =============================================================================
# Copy this file to .env only for local use if needed.
# Never commit .env or any file containing credentials, private links, signed
# URLs, or authentication tokens.

# Stable restricted-access folder containing both controlled archives and their
# companion .sha256 files. The same public request page is used for raw and
# frozen bundle access.
FAIRLAB_RAW_DATASET_BUNDLE_REQUEST_URL=https://drive.google.com/drive/folders/1cgQWKe9gPR1keJuoXeQ7SI6z-5IlAtF8

# Authorized direct-download URL for the controlled raw dataset bundle.
# Leave empty until access has been granted. Never commit signed or temporary URLs.
FAIRLAB_RAW_DATASET_BUNDLE_URL=

# Stable restricted-access folder containing the exact frozen 11,500-file
# evaluation bundle.
FAIRLAB_FROZEN_FORENSIC_EVALUATION_BUNDLE_REQUEST_URL=https://drive.google.com/drive/folders/1cgQWKe9gPR1keJuoXeQ7SI6z-5IlAtF8

# Authorized direct-download URL for the frozen evaluation bundle.
# Leave empty until access has been granted. Never commit signed or temporary URLs.
FAIRLAB_FROZEN_FORENSIC_EVALUATION_BUNDLE_URL=

# Telegram acquisition credentials.
# Required only for datasets/scripts/acquisition/05_scrape_telegram.py.
TELEGRAM_API_ID=YOUR_API_ID
TELEGRAM_API_HASH=YOUR_API_HASH
TELEGRAM_SESSION_NAME=telegram_osint_session
