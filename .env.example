# =============================================================================
# Environment variable template
# =============================================================================
# Copy this file to .env only for local use if needed.
# Never commit .env or any file containing credentials, private links, signed
# URLs, or authentication tokens.

# Stable access-request page for the controlled raw dataset bundle.
# This value is public and may be omitted because the repository includes the
# current stable raw-bundle request page.
FAIRLAB_RAW_DATASET_BUNDLE_REQUEST_URL=

# Authorized direct-download URL for the controlled raw dataset bundle.
# Leave empty until access has been granted.
FAIRLAB_RAW_DATASET_BUNDLE_URL=

# Stable access-request page for the exact frozen 11,500-file evaluation bundle.
# Configure this after the controlled upload has been frozen.
FAIRLAB_FROZEN_FORENSIC_EVALUATION_BUNDLE_REQUEST_URL=

# Authorized direct-download URL for the frozen evaluation bundle.
# Leave empty until access has been granted.
FAIRLAB_FROZEN_FORENSIC_EVALUATION_BUNDLE_URL=

# Telegram acquisition credentials.
# Required only for datasets/scripts/acquisition/05_scrape_telegram.py.
TELEGRAM_API_ID=YOUR_API_ID
TELEGRAM_API_HASH=YOUR_API_HASH
TELEGRAM_SESSION_NAME=telegram_osint_session
