% --- Header and footer ---
\usepackage{fancyhdr}
\usepackage{emptypage}

% Avoid fancyhdr headheight warnings.
\setlength{\headheight}{15pt}

% Front matter:
% no header, bottom rule, centered page number.
\fancypagestyle{frontmatterstyle}{
    \fancyhf{}
    \renewcommand{\headrulewidth}{0pt}
    \renewcommand{\footrulewidth}{0.4pt}
    \fancyfoot[C]{\thepage}
}

% Main matter:
% chapter title in the header, top rule,
% bottom rule and centered page number.
\fancypagestyle{mainmatterstyle}{
    \fancyhf{}
    \renewcommand{\headrulewidth}{0.4pt}
    \renewcommand{\footrulewidth}{0.4pt}
    \fancyhead[C]{\small\nouppercase{\leftmark}}
    \fancyfoot[C]{\thepage}
}

% Chapter-opening pages and other "plain" pages:
% no header title, only bottom rule and page number.
\fancypagestyle{plain}{
    \fancyhf{}
    \renewcommand{\headrulewidth}{0pt}
    \renewcommand{\footrulewidth}{0.4pt}
    \fancyfoot[C]{\thepage}
}


