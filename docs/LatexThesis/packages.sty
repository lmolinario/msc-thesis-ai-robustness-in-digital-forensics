% Standard acronym format:
% first use: long form (short form)
% later uses: short form only
\setacronymstyle{long-short}

% Bold first occurrences only when explicitly enabled.
% This keeps the Abstract and front matter unbolded, while allowing the thesis
% body to restart acronym usage from Chapter 1.
\newif\ifboldfirstacronyms
\boldfirstacronymsfalse
\newcommand{\EnableBoldFirstAcronyms}{\boldfirstacronymstrue}
\newcommand{\DisableBoldFirstAcronyms}{\boldfirstacronymsfalse}

\let\oldgls\gls
\let\oldGls\Gls
\let\oldglspl\glspl
\let\oldGlspl\Glspl

\RenewDocumentCommand{\gls}{m}{%
  \ifglsused{#1}{%
    \oldgls{#1}%
  }{%
    \ifboldfirstacronyms
      \ifglshaslong{#1}{%
        \textbf{\oldgls{#1}}%
      }{%
        \oldgls{#1}%
      }%
    \else
      \oldgls{#1}%
    \fi
  }%
}

\RenewDocumentCommand{\Gls}{m}{%
  \ifglsused{#1}{%
    \oldGls{#1}%
  }{%
    \ifboldfirstacronyms
      \ifglshaslong{#1}{%
        \textbf{\oldGls{#1}}%
      }{%
        \oldGls{#1}%
      }%
    \else
      \oldGls{#1}%
    \fi
  }%
}

\RenewDocumentCommand{\glspl}{m}{%
  \ifglsused{#1}{%
    \oldglspl{#1}%
