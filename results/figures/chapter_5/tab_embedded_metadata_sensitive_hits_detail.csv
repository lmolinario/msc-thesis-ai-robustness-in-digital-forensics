ustom NMI00001.mos\"" leaf:Filter=\""Green\"" leaf:DevelopCurve=\""Custom 22700001.mos\"" leaf:Height=\""4992\"" leaf:Moire=\""No Reduction\"" leaf:Grain=\""Aptus 75S Default Grain\"" leaf:ICCColor=\""On\"" leaf:Scale=\""100\"" leaf:Width=\""6666\"" leaf:ColorLook=\""Adobe RGB (1998)\"" leaf:Sharp=\""Aptus 75S Product\"" leaf:Resolution=\""300\"" leaf:ColorSpace=\""Adobe RGB (1998)\"" leaf:Flags=\""---\"" xmpMM:InstanceID=\""xmp.iid:D680792C0B206811822AF4A1D71A4931\"" xmpMM:DocumentID=\""xmp.did:04FC85AA47206811A6198D13334F7139\"" xmpMM:OriginalDocumentID=\""xmp.did:04FC85AA47206811A6198D13334F7139\"" nmipd:cnmuseumsite=\""Decorative Arts &amp; History\"" nmipd:cnmedium=\""digital\"" nmipd:cnacquisition=\""unknown\"" nmipd:cnconservationstatus=\""unknown\"" exifEX:PhotographicSensitivity=\""100\""> <xmpRights:UsageTerms> <rdf:Alt> <rdf:li xml:lang=\""x-default\"">not to be used without written permission</rdf:li> </rdf:Alt> </xmpRights:UsageTerms> <dc:creator> <rdf:Seq> <rdf:li>National Museum of Ireland</rdf:li> </rdf:Seq> </dc:creator> <dc:title> <rdf:Alt> <rdf:li xml:lang=\""x-default\"">NMIHA-2002-17b.tif</rdf:li> </rdf:Alt> </dc:title> <dc:rights> <rdf:Alt> <rdf:li xml:lang=\""x-default\"">© National Museum of Ireland</rdf:li> </rdf:Alt> </dc:rights> <dc:subject> <rdf:Bag> <rdf:li>objects</rdf:li> <rdf:li>sac_exhib_06</rdf:li> </rdf:Bag> </dc:subject> <dc:description> <rdf:Alt> <rdf:li xml:lang=\""x-default\"">Single barrelled shotgun. These assorted items suggest the difficulty of providing effective weapons to the rural fighters during the War of Independence.  Most farmers owned a shotgun — thus in the countryside they were the most common IRA weapon. When the proper ammunition was not available, cartridge cases would occasionally be refilled with gelignite, leading to accidents. HA:2002.17 (displayed in \""Soldiers &amp; Chiefs\"" exhibition at National Museum of Ireland - Decorative Arts &amp; History)</rdf:li> </rdf:Alt> </dc:description> <xmpMM:History> 